{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Hangfire is off: the API is deployed as a web tier only, with no background
  // worker. Program.cs defaults this to true, so it is set explicitly here — a
  // deploy that forgets the env var must not silently start a job server.
  //
  // Nothing enqueues jobs on demand (Hangfire appears only in Program.cs), so
  // this is safe. The recurring jobs it disables are, in order of consequence:
  //   CashbackCreditJob        credits due cashback into wallets  <-- MUST be
  //                            running before any cashback promo goes live, or
  //                            customers are owed money that is never paid
  //   GroupBookingExpiryJob    closes group bookings past expiry
  //   SubscriptionReminderJob  3-day "test due soon" push
  //   SlaMonitorJob            escalates SLA-breached support tickets
  //   ExpiredTokenCleanupJob   prunes expired refresh tokens / OTPs (bloat only;
  //                            expiry is enforced at validation regardless)
  //   SecurityAuditJob         weekly log line
  //   HealthScoreRecalcJob     empty scaffold
  //   RetestReminderJob        empty scaffold
  //
  // Cashback, subscriptions, and group bookings are not live features yet. When
  // any of them ships, run the same image as a second instance with
  // Jobs__Enabled=true instead of turning this back on in the web tier.
  "Jobs": {
    "Enabled": false
  },
  "Email": {
    "Provider": "Resend",
    "ResendApiKey": "YOUR_RESEND_API_KEY",
    "FromAddress": "Unique Diagnostic Centre <noreply@vitalscan.app>"
  },
  "Razorpay": {
    "KeyId": "",
    "KeySecret": "",
    "WebhookSecret": ""
  },
  // Firebase Cloud Messaging (push). Paste the full service-account JSON (one
  // line) into Firebase__ServiceAccountJson on the host. Empty = push disabled
  // (FcmNotificationService no-ops), so the app still runs without it.
  "Firebase": {
    "ServiceAccountJson": ""
  },
  // Social auth. GoogleClientId is the Firebase project's Web client id — the
  // audience Google ID tokens carry (the app signs in with this as serverClientId).
  // Public, not a secret; pinning it rejects tokens minted for any other client.
  "Auth": {
    "GoogleClientId": "381464039988-8nku4nsibvti1c6j8eiav8h95q45oe9m.apps.googleusercontent.com",
    // Play-review bypass for email OTP. Set BOTH on the host (Auth__ReviewerEmail,
    // Auth__ReviewerOtp) so Google's tester can log in without a real inbox.
    // Leave empty in normal operation; remove after the app is approved.
    "ReviewerEmail": "",
    "ReviewerOtp": ""
  }
}